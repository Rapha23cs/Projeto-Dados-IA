# ==========================================
# Variáveis de Ambiente - Projeto Dados IA
# ==========================================

# 1. Banco de Dados / Armazenamento (Ex: PostgreSQL local ou via Supabase)
DB_HOST=localhost
DB_PORT=5432
DB_NAME=projeto_dados
DB_USER=postgres
DB_PASSWORD=sua_senha_aqui

# Se for usar o Supabase, você pode usar a string de conexão direta:
# DATABASE_URL=postgresql://postgres:[YOUR-PASSWORD]@db.[YOUR-PROJECT-REF].supabase.co:5432/postgres

# Credenciais de API do Supabase (para uso do SDK client)
SUPABASE_URL=https://<your-project-ref>.supabase.co
SUPABASE_KEY=<your-anon-key>

# 2. IA / LLMs (Ex: OpenAI)
OPENAI_API_KEY=sk-proj-...

# 3. API / Web 
API_HOST=0.0.0.0
API_PORT=8000
